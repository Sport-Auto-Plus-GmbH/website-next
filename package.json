{
  "name": "website-next",
  "version": "0.1.0",
  "private": true,
  "description": "Public Next.js website for Sport Auto Plus, backed by the payload-next CMS.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:datendrehscheibe-types": "openapi-typescript openapi/datendrehscheibe/api-vehicles-v1.0.yaml -o src/lib/datendrehscheibe/generated/vehicles.d.ts",
    "sync:datendrehscheibe": "node ../Datendrehscheibe/tools/openapi-sync/sync.js --domain vehicles --dest openapi/datendrehscheibe && pnpm generate:datendrehscheibe-types && pnpm format",
    "dev:sync-datendrehscheibe": "chokidar \"../Datendrehscheibe/de.saplus.datahub.api.http/src/main/openapi/**/*.yaml\" -c \"pnpm sync:datendrehscheibe\" --initial",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/pro-duotone-svg-icons": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@fortawesome/pro-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "next": "16.3.4",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
