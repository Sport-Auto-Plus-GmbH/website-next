# Base URL of the payload-next CMS's REST API. Server-only — never prefix this
# with NEXT_PUBLIC_ (see .ai/backend/SECURITY.md).
PAYLOAD_API_URL=http://localhost:3000

# Same value as PAYLOAD_API_URL, but intentionally public (NEXT_PUBLIC_): Live Preview's
# useLivePreview hook runs client-side and needs the CMS's origin to verify the
# `postMessage` it receives actually came from Payload's admin panel, not some other
# origin. This is not a secret — it's the CMS's own public base URL.
NEXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3000

# Base URL of the Datendrehscheibe's HTTP API. Server-only — same rule as above.
DATENDREHSCHEIBE_API_URL=http://localhost:8080

# Shared secret payload-next sends in the `x-revalidate-secret` header when it calls
# /api/revalidate after a Page changes. Must be the exact same value as payload-next's
# own REVALIDATE_SECRET — see that project's .env.example.
REVALIDATE_SECRET=YOUR_SECRET_HERE
